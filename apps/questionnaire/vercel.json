{
  "version": 2,
  "buildCommand": "cd ../.. && npm ci && npm run build",
  "builds": [
    { "src": "api/questionnaire.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/test-ui.html", "destination": "/public/test-ui.html" },
    { "source": "/public/:path*", "destination": "/public/:path*" },
    { "source": "/healthz", "destination": "/api/questionnaire" },
    { "source": "/readyz", "destination": "/api/questionnaire" },
    { "source": "/questionnaires", "destination": "/api/questionnaire" },
    { "source": "/questionnaires/:path*", "destination": "/api/questionnaire" },
    { "source": "/admin", "destination": "/api/questionnaire" },
    { "source": "/admin/:path*", "destination": "/api/questionnaire" },
    { "source": "/", "destination": "/public/index.html" }
  ]
}
